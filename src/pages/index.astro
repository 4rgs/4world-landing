---
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>4World | Cyber-Pixel Universe RPG</title>
    <meta name="description" content="4 a New World RPG. Mundo persistente." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Audiowide&family=Press+Start+2P&display=swap" rel="stylesheet" />
  </head>
  <body class="scanlines bg-[#0a0a0a] text-white min-h-screen flex flex-col items-center">
    <main class="relative w-full max-w-6xl px-4 py-10 text-center">
      <div class="relative inline-block">
        <h1 class="text-6xl md:text-9xl font-bold tracking-tighter neon-text-pink mb-6 leading-tight drop-shadow-[0_0_30px_rgba(255,0,170,1)] animate-pulse">4WORLD</h1>
        <div class="absolute -top-4 -left-4 w-full h-full bg-pink-500 blur-[120px] opacity-30 rounded-full"></div>
      </div>
      <p class="font-bold text-2xl md:text-3xl text-cyan-300 max-w-2xl mx-auto mb-4 tracking-wider" style="font-family: Audiowide, system-ui, sans-serif">UN MUNDO NUEVO TE ESPERA</p>
      <p class="text-base md:text-lg text-gray-300 max-w-2xl mx-auto mb-12 leading-relaxed">Mundo persistente generado a partir de datos geograficos reales.
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="4World | Cyber-Pixel Universe RPG" />
    <meta name="twitter:description" content="4 a New World RPG. Mundo persistente multijugador." />
    <meta name="twitter:image" content="/img/app-preview.jpg" />
    <meta property="og:image" content="/img/app-preview.jpg" /></p>
      <div class="flex flex-wrap gap-6 justify-center mt-8">
        <a href="#play" class="px-8 py-4 bg-pink-600 hover:bg-pink-500 text-white font-bold border-b-4 border-pink-900">ENTRAR AL MUNDO</a>
        <a href="#preview" class="px-8 py-4 border-2 border-cyan-500 text-cyan-400 hover:bg-cyan-500 hover:text-white font-bold">VER MUNDO</a>
      </div>
    </main>

    
    <section class="w-full max-w-6xl px-4 py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-4xl md:text-6xl font-bold neon-text-cyan" style="font-family: Audiowide, system-ui, sans-serif">100+</div>
          <div class="text-sm text-gray-400 mt-2 uppercase tracking-wider" style="font-family: Press Start 2P, monospace">Jugadores</div>
        </div>
        <div>
          <div class="text-4xl md:text-6xl font-bold neon-text-pink" style="font-family: Audiowide, system-ui, sans-serif">4</div>
          <div class="text-sm text-gray-400 mt-2 uppercase tracking-wider" style="font-family: Press Start 2P, monospace">Pilares</div>
        </div>
        <div>
          <div class="text-4xl md:text-6xl font-bold neon-text-cyan" style="font-family: Audiowide, system-ui, sans-serif">24/7</div>
          <div class="text-sm text-sm text-gray-400 mt-2 uppercase tracking-wider" style="font-family: Press Start 2P, monospace">Online</div>
        </div>
        <div>
          <div class="text-4xl md:text-6xl font-bold neon-text-pink" style="font-family: Audiowide, system-ui, sans-serif">v1.17</div>
          <div class="text-sm text-gray-400 mt-2 uppercase tracking-wider" style="font-family: Press Start 2P, monospace">Release</div>
        </div>
      </div>
    </section>

    <section id="preview" class="w-full max-w-6xl px-4 py-16">
      <h2 class="text-5xl md:text-7xl font-bold text-center mb-4 neon-text-cyan">EL MUNDO</h2>
      <p class="text-center text-gray-400 mb-12">Captura real del juego en produccion</p>
      <div class="relative pixel-border p-2 bg-black/80 shadow-[0_0_50px_rgba(0,255,255,0.4)]">
        <img src="/img/app-preview.jpg" alt="Captura del juego 4World" class="w-full h-auto block" />
        <div class="absolute top-4 left-4 bg-pink-600 text-white text-sm px-4 py-2 font-bold animate-pulse border border-pink-400" style="font-family: Press Start 2P, monospace">LIVE</div>
        <div class="absolute bottom-4 right-4 bg-black/80 text-cyan-300 text-xs px-3 py-1 border border-cyan-500" style="font-family: Press Start 2P, monospace">v1.17.3</div>
      </div>
    </section>

    <section id="features" class="w-full max-w-6xl px-4 py-16">
      <h2 class="text-5xl md:text-7xl font-bold text-center mb-16 neon-text-cyan">CAPACIDADES</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="pixel-border p-6 bg-black/80 hover:bg-pink-950/30 hover:scale-105 transition-all duration-300">
          <div class="text-2xl mb-3 text-cyan-400" style="font-family: Press Start 2P, monospace">01</div>
          <h3 class="font-bold text-cyan-400 text-lg mb-3" style="font-family: Audiowide, system-ui, sans-serif">Mapa Interactivo</h3>
          <p class="text-sm text-gray-300">Mundo 2D generado a partir de datos geograficos reales.</p>
        </div>
        <div class="pixel-border p-6 bg-black/80 hover:bg-pink-950/30 hover:scale-105 transition-all duration-300">
          <div class="text-2xl mb-3 text-pink-400" style="font-family: Press Start 2P, monospace">02</div>
          <h3 class="font-bold text-pink-400 text-lg mb-3" style="font-family: Audiowide, system-ui, sans-serif">Combate en Tiempo Real</h3>
          <p class="text-sm text-gray-300">Sistema tactico con habilidades.</p>
        </div>
        <div class="pixel-border p-6 bg-black/80 hover:bg-pink-950/30 hover:scale-105 transition-all duration-300">
          <div class="text-2xl mb-3 text-cyan-400" style="font-family: Press Start 2P, monospace">03</div>
          <h3 class="font-bold text-cyan-400 text-lg mb-3" style="font-family: Audiowide, system-ui, sans-serif">Multijugador Online</h3>
          <p class="text-sm text-gray-300">Servidor persistente compartido.</p>
        </div>
        <div class="pixel-border p-6 bg-black/80 hover:bg-pink-950/30 hover:scale-105 transition-all duration-300">
          <div class="text-2xl mb-3 text-pink-400" style="font-family: Press Start 2P, monospace">04</div>
          <h3 class="font-bold text-pink-400 text-lg mb-3" style="font-family: Audiowide, system-ui, sans-serif">Inventario y Comercio</h3>
          <p class="text-sm text-gray-300">Items y economia dinamica.</p>
        </div>
      </div>
    </section>

    <section class="w-full max-w-4xl px-4 py-12 text-center">
      <div class="pixel-border p-8">
        <p class="text-sm text-pink-400 mb-4 tracking-wider" style="font-family: Press Start 2P, monospace">
    <section id="roadmap" class="w-full max-w-6xl px-4 py-16">
      <h2 class="text-5xl md:text-7xl font-bold text-center mb-4 neon-text-pink">QUE VIENE</h2>
      <p class="text-center text-gray-400 mb-12">Roadmap publico del proyecto</p>
      <div class="space-y-6">
        <div class="pixel-border p-6 bg-black/80 flex items-start gap-4">
          <div class="text-2xl text-cyan-400 font-bold" style="font-family: Press Start 2P, monospace">Q3</div>
          <div class="flex-1">
            <h3 class="text-cyan-400 font-bold text-lg mb-2" style="font-family: Audiowide, system-ui, sans-serif">Sistema de Clanes</h3>
            <p class="text-sm text-gray-300">Forma clanes con otros jugadores, declara guerras, construye bases compartidas.</p>
          </div>
        </div>
        <div class="pixel-border p-6 bg-black/80 flex items-start gap-4">
          <div class="text-2xl text-pink-400 font-bold" style="font-family: Press Start 2P, monospace">Q4</div>
          <div class="flex-1">
            <h3 class="text-pink-400 font-bold text-lg mb-2" style="font-family: Audiowide, system-ui, sans-serif">Misiones Cooperativas</h3>
            <p class="text-sm text-gray-300">Eventos globales donde la comunidad une fuerzas contra jefes epicos.</p>
          </div>
        </div>
        <div class="pixel-border p-6 bg-black/80 flex items-start gap-4">
          <div class="text-2xl text-cyan-400 font-bold" style="font-family: Press Start 2P, monospace">Q1</div>
          <div class="flex-1">
            <h3 class="text-cyan-400 font-bold text-lg mb-2" style="font-family: Audiowide, system-ui, sans-serif">Economia Descentralizada</h3>
            <p class="text-sm text-gray-300">Sistema de comercio entre jugadores con subastas y mercado global.</p>
          </div>
        </div>
      </div>
    </section>

    RED ALERT</p>
        <p class="text-2xl md:text-3xl font-bold text-white neon-text-cyan mb-2">EL MUNDO TE ESPERA</p>
        <p class="text-base md:text-lg text-gray-300">Acceso anticipado</p>
      </div>
    </section>

    <section id="play" class="w-full max-w-4xl px-4 py-20 text-center">
      <h2 class="text-3xl md:text-5xl font-bold mb-6 neon-text-pink">LISTO PARA ENTRAR?</h2>
      <p class="text-gray-300 mb-8">Tu leyenda empieza ahora.</p>
      <a href="https://app.spids.cl" class="inline-block px-16 py-6 bg-pink-600 hover:bg-pink-500 text-white font-bold text-2xl border-b-4 border-pink-900 transition-all animate-pulse">JUGAR AHORA</a>
    </section>

    <footer class="w-full max-w-6xl px-4 py-12 border-t border-cyan-900/30 mt-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm">
        <div>
          <h4 class="font-bold text-cyan-400 mb-3" style="font-family: Audiowide, system-ui, sans-serif">4WORLD</h4>
          <p class="text-gray-400 text-xs">Cyber-Pixel Universe RPG</p>
        </div>
        <div>
          <h4 class="font-bold text-cyan-400 mb-3" style="font-family: Audiowide, system-ui, sans-serif">COMUNIDAD</h4>
                    <div class="flex gap-4">
            <a href="#discord" class="text-cyan-400 hover:text-cyan-300" aria-label="Discord"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z\"/></svg></a>
            <a href="#github" class="text-cyan-400 hover:text-cyan-300" aria-label="GitHub"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\"/></svg></a>
            <a href="#twitter" class="text-cyan-400 hover:text-cyan-300" aria-label="Twitter"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"/></svg></a>
          </div>
        </div>
        <div>
          <h4 class="font-bold text-cyan-400 mb-3" style="font-family: Audiowide, system-ui, sans-serif">PROYECTO</h4>
          <ul class="space-y-2 text-gray-400 text-xs">
            <li><a href="https://github.com/4rgs/4world" class="hover:text-cyan-300">GitHub</a></li>
            <li><a href="#wiki" class="hover:text-cyan-300">Wiki</a></li>
            <li><a href="#changelog" class="hover:text-cyan-300">Changelog</a></li>
          </ul>
        </div>
      </div>
      <div class="mt-8 pt-6 border-t border-cyan-900/20 text-center text-xs text-gray-500">© 2026 4World</div>
    </footer>
  </body>
</html>
